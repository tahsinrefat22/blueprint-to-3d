---
import { decisions, nextSteps } from "../spec";
import type { Decision } from "../spec/schema";
import Pill from "./ui/Pill.astro";
import SectionHead from "./ui/SectionHead.astro";

const all: readonly Decision[] = decisions;
const settled = all.filter((d) => d.status === "settled");
const open = all.filter((d) => d.status === "open");
const card = "grid content-start gap-3 rounded-xl border bg-panel px-5 py-4.5";
---

<section class="grid gap-4">
  <SectionHead eyebrow="Decisions" title="Settled and still open" />
  <div class="grid gap-4 min-[900px]:grid-cols-2">
    <div class={`${card} border-line`}>
      <h3 class="m-0"><Pill kind="settled" /></h3>
      {settled.length === 0 && <p class="m-0 text-sm text-muted">Nothing settled yet.</p>}
      <ul class="m-0 grid gap-2 pl-5 text-sm">
        {settled.map((d) => <li><b>{d.title}</b> ({d.id}). {d.summary}</li>)}
      </ul>
    </div>
    <div class={`${card} border-warn`}>
      <h3 class="m-0"><Pill kind="open" /></h3>
      {open.length === 0 && <p class="m-0 text-sm text-muted">Nothing open.</p>}
      <ul class="m-0 grid gap-2 pl-5 text-sm">
        {open.map((d) => <li><b>{d.title}</b> ({d.id}). {d.summary}</li>)}
      </ul>
    </div>
  </div>
  <div class={`${card} border-line`}>
    <h3 class="m-0 font-display text-lg font-semibold">What happens next</h3>
    <ol class="m-0 grid gap-2 pl-5 text-sm">
      {nextSteps.map((s) => <li>{s}</li>)}
    </ol>
  </div>
</section>
