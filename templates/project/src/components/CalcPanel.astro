---
/**
 * Live engineering calculations: inputs on the left, every graph node on the right with its limit
 * state. Changing an input re-evaluates the graph, marks the outputs it affects, and broadcasts the
 * results (CALC_EVENT) so the 3D model and key-number tiles follow.
 */
import { type CalcInput, type CalcNode, evaluate, formatValue, limitState } from "../engine/graph";
import { projectGraph } from "../engine/project-graph";
import { values } from "../spec";
import { CONFIDENCE_KIND } from "./status";
import Pill from "./ui/Pill.astro";
import SectionHead from "./ui/SectionHead.astro";

const results = evaluate(projectGraph);
const nodes: readonly CalcNode[] = projectGraph.nodes;
const inputs: readonly CalcInput[] = projectGraph.inputs;
const confidenceOf = (key: string | undefined) =>
  key ? values[key as keyof typeof values]?.confidence : undefined;
---

<section class="grid gap-4" data-calc>
  <SectionHead eyebrow="Engineering model" title="Live calculations">
    Change an input and every dependent quantity recomputes; outputs it affects are marked. Formulas and
    sources are in docs/06-engineering-model.md and src/engine/formulas. Calculations only, no simulation.
  </SectionHead>
  <div class="grid gap-4 min-[900px]:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)]">
    <div class="grid content-start gap-4 rounded-xl border border-line bg-panel p-5">
      {
        inputs.map((input) => {
          const confidence = confidenceOf(input.valueKey);
          return (
            <div class="grid gap-1">
              <label for={`calc-${input.id}`} class="flex items-center justify-between gap-2 text-[13px] font-medium">
                <span>{input.label}</span>
                <span class="font-mono font-normal text-accent">
                  <span data-calc-in-out={input.id}>{input.initial}</span> {input.unit}
                </span>
              </label>
              <input
                id={`calc-${input.id}`}
                type="range"
                class="w-full accent-accent"
                data-calc-in={input.id}
                min={input.min}
                max={input.max}
                step={input.step}
                value={input.initial}
              />
              <div class="flex flex-wrap items-center gap-2 text-xs text-muted">
                {confidence && <Pill kind={CONFIDENCE_KIND[confidence] ?? "none"} label={`spec: ${confidence}`} />}
                {input.help && <span>{input.help}</span>}
              </div>
            </div>
          );
        })
      }
      <div>
        <button
          type="button"
          data-calc-reset
          class="cursor-pointer rounded-md border border-line bg-panel px-2.5 py-1.5 font-mono text-xs font-medium text-ink hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          Reset to spec
        </button>
      </div>
    </div>

    <div class="overflow-x-auto rounded-xl border border-line bg-panel">
      <table class="w-full min-w-[460px] border-collapse text-sm">
        <thead>
          <tr class="bg-stage text-left font-mono text-xs tracking-[0.06em] text-muted uppercase">
            <th class="border-b border-line px-3.5 py-2.5 font-medium">Quantity</th>
            <th class="border-b border-line px-3.5 py-2.5 text-right font-medium">Value</th>
            <th class="border-b border-line px-3.5 py-2.5 font-medium">Limit</th>
          </tr>
        </thead>
        <tbody>
          {
            nodes.map((node) => {
              const value = results[node.id] ?? Number.NaN;
              const { limit } = node;
              const state = limitState(limit, value);
              return (
                <tr
                  data-calc-row={node.id}
                  data-affected="false"
                  class="border-l-2 border-l-transparent transition-colors data-[affected=true]:border-l-accent data-[affected=true]:bg-accent-soft/40"
                >
                  <td class="border-b border-line px-3.5 py-2" title={node.help}>
                    {node.label}
                  </td>
                  <td class="border-b border-line px-3.5 py-2 text-right font-mono whitespace-nowrap tabular-nums">
                    <span data-calc-out={node.id}>{formatValue(value, node.digits)}</span>
                    <span class="text-muted"> {node.unit}</span>
                  </td>
                  <td class="border-b border-line px-3.5 py-2">
                    {limit ? (
                      <span class="flex flex-wrap items-center gap-2" title={limit.label}>
                        <span data-calc-state={node.id}>
                          <Pill kind={state} />
                        </span>
                        <span class="font-mono text-xs text-muted">
                          {limit.max !== undefined ? `≤ ${limit.max}` : `≥ ${limit.min}`}
                        </span>
                      </span>
                    ) : (
                      <span class="text-muted">—</span>
                    )}
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<script>
  import { pillClass, statusText } from "../components/status";
  import { type CalcNode, downstream, evaluate, formatValue, limitState, orderNodes } from "../engine/graph";
  import { projectGraph } from "../engine/project-graph";
  import { CALC_EVENT } from "../events";

  const root = document.querySelector<HTMLElement>("[data-calc]");
  if (root) {
    const order = orderNodes(projectGraph);
    const nodes: readonly CalcNode[] = projectGraph.nodes;
    const inputs = new Map(
      projectGraph.inputs.map((def) => [def.id, root.querySelector<HTMLInputElement>(`[data-calc-in="${def.id}"]`)]),
    );

    const run = (changed: string | null): void => {
      const overrides: Record<string, number> = {};
      for (const [id, el] of inputs) if (el) overrides[id] = Number(el.value);
      const results = evaluate(projectGraph, overrides, order);
      const affected = new Set(changed ? downstream(projectGraph, changed) : []);
      for (const def of projectGraph.inputs) {
        const out = root.querySelector(`[data-calc-in-out="${def.id}"]`);
        if (out) out.textContent = String(overrides[def.id] ?? def.initial);
      }
      for (const node of nodes) {
        const value = results[node.id] ?? Number.NaN;
        const out = root.querySelector(`[data-calc-out="${node.id}"]`);
        if (out) out.textContent = formatValue(value, node.digits);
        const row = root.querySelector<HTMLElement>(`[data-calc-row="${node.id}"]`);
        if (row) row.dataset.affected = String(affected.has(node.id));
        const pill = root.querySelector(`[data-calc-state="${node.id}"] > span`);
        if (pill && node.limit) {
          const state = limitState(node.limit, value);
          pill.className = pillClass(state);
          pill.textContent = statusText(state);
        }
      }
      document.dispatchEvent(new CustomEvent(CALC_EVENT, { detail: results }));
    };

    for (const [id, el] of inputs) el?.addEventListener("input", () => run(id));
    root.querySelector("[data-calc-reset]")?.addEventListener("click", () => {
      for (const def of projectGraph.inputs) {
        const el = inputs.get(def.id);
        if (el) el.value = String(def.initial);
      }
      run(null);
    });
  }
</script>
