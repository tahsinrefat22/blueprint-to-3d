---
/**
 * The 3D viewer and its side panel. All behaviour lives in src/model/index.ts, which finds the
 * elements below by their data-* attributes.
 */
import { formatValue } from "../engine/graph";
import { parts, values, viewerControls } from "../spec";
import { CONFIDENCE_KIND } from "./status";
import Pill from "./ui/Pill.astro";

const btn =
  "cursor-pointer rounded-md border border-line bg-panel px-2.5 py-1.5 font-mono text-xs font-medium tracking-[0.03em] text-ink hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent aria-pressed:border-accent aria-pressed:bg-accent-soft aria-pressed:text-accent disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:border-line disabled:hover:text-ink";
const btnPrimary =
  "cursor-pointer rounded-md border border-accent bg-accent px-2.5 py-1.5 font-mono text-xs font-medium tracking-[0.03em] text-panel hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent";
const block = "grid gap-3 border-b border-line p-4";

const partInfo = parts.map((part) => {
  const mass = values[part.massKey as keyof typeof values];
  const count = part.instances.length;
  const each = `${formatValue(mass.value, 1)} g`;
  return {
    ...part,
    massText: count > 1 ? `×${count} · ${each} each` : each,
    confidence: mass.confidence,
  };
});
---

<section aria-label="3D model" data-viewer>
  <div
    class="grid overflow-hidden rounded-xl border border-line bg-panel min-[900px]:grid-cols-[minmax(0,1fr)_340px]"
  >
    <div
      data-stage
      data-window-fullscreen="false"
      class="relative min-w-0 bg-[radial-gradient(120%_90%_at_50%_40%,var(--stage),var(--paper))] data-[window-fullscreen=true]:fixed data-[window-fullscreen=true]:inset-0 data-[window-fullscreen=true]:z-50"
    >
      <div
        data-viewport
        data-grid="false"
        class="relative h-[400px] w-full touch-none overflow-hidden data-[grid=true]:h-[900px] min-[520px]:h-[460px] min-[900px]:h-[640px] min-[900px]:data-[grid=true]:h-[760px] data-[fullscreen=true]:h-dvh!"
      >
        <p data-fallback hidden class="p-6 text-muted">
          The 3D model could not load (WebGL unavailable). The numbers below are unaffected.
        </p>
      </div>
      <fieldset class="absolute top-3 left-3 z-10 m-0 flex flex-wrap gap-1.5 border-0 p-0">
        <legend class="sr-only">Camera views</legend>
        <button type="button" class={btn} data-view="iso">3/4 view</button>
        <button type="button" class={btn} data-view="front">Front</button>
        <button type="button" class={btn} data-view="rear">Rear</button>
        <button type="button" class={btn} data-view="left">Left</button>
        <button type="button" class={btn} data-view="right">Right</button>
        <button type="button" class={btn} data-view="top">Top</button>
        <button type="button" class={btn} data-view="bottom">Bottom</button>
      </fieldset>
      <button
        type="button"
        data-fullscreen-toggle
        aria-pressed="false"
        class={`absolute top-3 right-3 z-10 ${btn}`}
      >
        Full screen
      </button>
      <fieldset class="absolute bottom-2 left-3 z-10 m-0 flex items-center gap-1.5 border-0 p-0">
        <legend class="sr-only">Zoom</legend>
        <button type="button" class={`${btn} w-8 px-0`} data-zoom-out aria-label="Zoom out">−</button>
        <span data-zoom-level aria-live="polite" class="min-w-[4.5ch] text-center font-mono text-[11px] text-muted">
          100%
        </span>
        <button type="button" class={`${btn} w-8 px-0`} data-zoom-in aria-label="Zoom in">+</button>
      </fieldset>
      <div data-speed-note class="absolute right-3 bottom-2.5 font-mono text-[11px] text-muted"></div>
      <div
        data-tip
        hidden
        class="pointer-events-none absolute z-20 translate-x-2.5 translate-y-2.5 rounded-md bg-ink px-2 py-1 text-xs whitespace-nowrap text-paper"
      >
      </div>
    </div>

    <div class="flex min-w-0 flex-col border-t border-line min-[900px]:border-t-0 min-[900px]:border-l">
      <div class={block}>
        <div class="flex flex-wrap items-center gap-2">
          <button type="button" class={btnPrimary} data-play aria-pressed="false">Play</button>
          <button type="button" class={btn} data-reset>Reset controls</button>
        </div>
        {
          viewerControls.map((c) => (
            <div class="grid gap-1">
              <label for={`ctl-${c.id}`} class="flex justify-between text-[13px] font-medium">
                {c.label}
                <span data-control-out={c.id} class="font-mono font-normal text-accent">
                  {c.initial}
                  {c.unit}
                </span>
              </label>
              <input
                id={`ctl-${c.id}`}
                type="range"
                class="w-full accent-accent"
                data-control={c.id}
                min={c.min}
                max={c.max}
                step={c.step}
                value={c.initial}
              />
              <small class="text-xs leading-snug text-muted">{c.help}</small>
            </div>
          ))
        }
      </div>

      <div class={block}>
        <div class="flex items-center justify-between">
          <h3 class="m-0 font-display text-lg font-semibold">Take it apart</h3>
          <span data-step-count class="font-mono text-xs text-muted">0 / 0</span>
        </div>
        <div class="flex flex-wrap gap-2">
          <button type="button" class={btn} data-step-prev>Put back</button>
          <button type="button" class={btnPrimary} data-step-next>Remove next</button>
        </div>
        <div class="flex flex-wrap gap-2">
          <button type="button" class={btn} data-explode-all>Explode all</button>
          <button type="button" class={btn} data-explode-grid aria-pressed="false">Explode with labels</button>
        </div>
        <p data-step-caption class="m-0 min-h-[3.2em] text-[13.5px]"></p>
      </div>

      <div class={block}>
        <fieldset class="m-0 flex flex-wrap gap-1.5 border-0 p-0">
          <legend class="sr-only">Parts</legend>
          {
            parts.map((p) => (
              <button
                type="button"
                data-legend-part={p.key}
                aria-pressed="false"
                class="inline-flex cursor-pointer items-center gap-1.5 rounded-full border border-line bg-transparent px-2 py-1 text-xs text-ink hover:border-accent focus-visible:outline-2 focus-visible:outline-accent aria-pressed:border-accent aria-pressed:bg-accent-soft"
              >
                <span class="inline-block size-2 flex-none rounded-full" style={`background:${p.color}`} />
                {p.name}
              </button>
            ))
          }
        </fieldset>
      </div>

      <!-- Part details sit below the legend: pick a part above, read about it here. -->
      <div class={block} aria-live="polite">
        <p data-info-empty class="m-0 text-[13.5px] text-muted">Click a part in the model, or pick one above.</p>
        {
          partInfo.map((p) => (
            <div data-info-part={p.key} hidden class="grid gap-2">
              <div class="flex items-center justify-between gap-2">
                <span class="font-display text-[19px] leading-tight font-semibold">{p.name}</span>
                <Pill kind={p.status} />
              </div>
              <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-muted">
                {p.massText}
                <Pill kind={CONFIDENCE_KIND[p.confidence] ?? "none"} label={p.confidence} />
              </div>
              <p class="m-0 text-[13.5px]">{p.description}</p>
              <div class="mt-0.5 text-xs text-muted">Where to find it in the repo</div>
              <ul class="m-0 grid list-none gap-0.5 p-0">
                {p.files.map((f) => (
                  <li>
                    <code class="font-mono text-[11.5px] break-all text-accent">{f}</code>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { mountViewer } from "../model";

  const root = document.querySelector<HTMLElement>("[data-viewer]");
  if (root) mountViewer(root);
</script>
